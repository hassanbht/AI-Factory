# ============================================================
# AI Factory — Production Environment Configuration Template
# Copy to .env and fill in required values.
# NEVER commit the actual .env file with real secrets!
# ============================================================

# Environment
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# API Host Port Mapping
API_PORT=8080

# AI Provider Credentials (resolved via EnvironmentSecretProvider)
OPENROUTER_API_KEY=your-production-openrouter-api-key-here

# Operational Endpoint Access Protection (Phase 17.4.5 & Phase 17.4.6)
REQUIRE_OPERATIONAL_KEY=false
OPERATIONAL_ACCESS_KEY=your-secure-random-operational-access-key

# Build Metadata (Optional — injected by CI/CD build pipelines)
BUILD_COMMIT=local-dev
BUILD_TIMESTAMP=2026-09-03T00:00:00Z
