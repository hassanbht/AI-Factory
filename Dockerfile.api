# ------------------------------------------------------------
# AI.Factory.Api — Production Multi-Stage Dockerfile
# ------------------------------------------------------------

# Stage 1: Runtime Base
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    ASPNETCORE_ENVIRONMENT=Production

# Install curl for reliable container health checking
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Configure healthcheck using the liveness endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health/live || exit 1

# Stage 2: Build & Restore
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Layer caching: copy solution and project files first
COPY apps/AI.Factory.slnx apps/
COPY apps/src/AI.Factory.Domain/AI.Factory.Domain.csproj apps/src/AI.Factory.Domain/
COPY apps/src/AI.Factory.Application/AI.Factory.Application.csproj apps/src/AI.Factory.Application/
COPY apps/src/AI.Factory.Infrastructure/AI.Factory.Infrastructure.csproj apps/src/AI.Factory.Infrastructure/
COPY apps/src/AI.Factory.Api/AI.Factory.Api.csproj apps/src/AI.Factory.Api/
COPY apps/src/AI.Factory.Worker/AI.Factory.Worker.csproj apps/src/AI.Factory.Worker/
COPY apps/tests/AI.Factory.Application.Tests/AI.Factory.Application.Tests.csproj apps/tests/AI.Factory.Application.Tests/
COPY apps/tests/AI.Factory.Worker.Tests/AI.Factory.Worker.Tests.csproj apps/tests/AI.Factory.Worker.Tests/
COPY apps/tests/AI.Factory.Api.Tests/AI.Factory.Api.Tests.csproj apps/tests/AI.Factory.Api.Tests/

RUN dotnet restore apps/src/AI.Factory.Api/AI.Factory.Api.csproj

# Copy remaining source code
COPY apps/src/ apps/src/

# Version metadata (Phase 17.5.1) — property names match apps/Directory.Build.props exactly.
# Local builds keep the defaults below; CI/release builds override them via --build-arg.
ARG BUILD_VERSION=0.0.0-dev
ARG GIT_COMMIT=local
ARG GIT_BRANCH=local
ARG BUILD_NUMBER=0
ARG BUILD_TIMESTAMP_UTC=unknown

# Build in Release configuration
WORKDIR /src/apps/src/AI.Factory.Api
RUN dotnet build AI.Factory.Api.csproj -c Release --no-restore -p:SemanticVersion=$BUILD_VERSION -p:GitCommit=$GIT_COMMIT -p:GitBranch=$GIT_BRANCH -p:BuildNumber=$BUILD_NUMBER

# Stage 3: Publish
FROM build AS publish
RUN dotnet publish AI.Factory.Api.csproj -c Release -o /app/publish --no-build /p:UseAppHost=false

# Stage 4: Final Production Runtime Image
FROM base AS final
WORKDIR /app

# Docker ARGs don't cross stages — redeclare, then expose as runtime ENV so
# DeploymentDiagnosticsService (Phase 17.5.1) can read them from the running container.
ARG BUILD_VERSION=0.0.0-dev
ARG GIT_COMMIT=local
ARG GIT_BRANCH=local
ARG BUILD_NUMBER=0
ARG BUILD_TIMESTAMP_UTC=unknown
# The Dockerfile alone doesn't know the repo URL, so it's passed in separately (defaults to
# "unknown" for local builds; release.yml passes the real https://github.com/<owner>/<repo>).
ARG IMAGE_SOURCE_URL=unknown
ENV BUILD_COMMIT=$GIT_COMMIT \
    BUILD_BRANCH=$GIT_BRANCH \
    BUILD_NUMBER=$BUILD_NUMBER \
    BUILD_TIMESTAMP_UTC=$BUILD_TIMESTAMP_UTC

# Standard OCI labels (phase 17.5.2). Values come from the same ARGs used for the assembly
# version metadata above (SemanticVersion/GitCommit/BuildTimestampUtc via Directory.Build.props),
# and release.yml passes matching --label flags at build time — no independent version source.
LABEL org.opencontainers.image.version=$BUILD_VERSION \
      org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.created=$BUILD_TIMESTAMP_UTC \
      org.opencontainers.image.source=$IMAGE_SOURCE_URL

# Ensure persistent and temporary directory structures exist and are owned by non-root user
RUN mkdir -p /var/lib/ai-factory/data /var/lib/ai-factory/backups /tmp/ai-factory && \
    chown -R $APP_UID:$APP_UID /var/lib/ai-factory /tmp/ai-factory /app

# Copy published artifacts from publish stage
COPY --from=publish --chown=$APP_UID:$APP_UID /app/publish .

# Run as dedicated non-root user (UID 1654)
USER $APP_UID

# Exec-form entrypoint ensures SIGTERM signals are received directly by the .NET process
ENTRYPOINT ["dotnet", "AI.Factory.Api.dll"]
