# ------------------------------------------------------------
# AI.Factory.Worker — Production Multi-Stage Dockerfile
# ------------------------------------------------------------

# Stage 0: Docker CLI source (Phase 18.29.1)
# HermesAgentExecutor executes agents by running the Hermes container
# (`docker run nousresearch/hermes-agent`). Without a Docker CLI in this image the
# Worker container cannot execute ANY agent — it fails with "Failed to start
# process 'docker'", which is exactly what blocked the v1.0.0 release gate.
#
# Only the client binary is taken, never a daemon: this image does not run Docker,
# it talks to a daemon whose socket the deployment mounts in. See the security note
# on the `worker` service in docker-compose.yml.
#
# 29-cli specifically, and only /usr/local/bin/docker: the 28-cli client is built on
# Go 1.25.3 and carries 22 HIGH/CRITICAL stdlib CVEs, which correctly failed the
# release pipeline's Trivy gate. The 29-cli client scans clean. Its cli-plugins
# (docker-buildx) still carry HIGH findings and are deliberately NOT copied — the
# Worker issues `docker run`, it never builds images.
FROM docker:29-cli AS dockercli

# Stage 1: Runtime Base (Phase 18.29.1 — SDK, not runtime)
#
# The Worker does not merely host .NET code, it COMPILES AND TESTS the code the
# agents produce: DotNetBuildExecutor/DotNetTestExecutor shell out to `dotnet build`
# and `dotnet test` as the Factory's verification gate. On the runtime-only image
# that failed with "No .NET SDKs were found" (exit 155) for every WorkItem, which
# then drove the repair loop into repeatedly "fixing" a defect that was in the image
# rather than in the generated code — one repair attempt went as far as downloading
# an entire .NET SDK into the project workspace.
#
# The cost is a substantially larger image. That is the honest price of what the
# Worker actually does; the API image is unaffected and stays on the runtime base.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS base
WORKDIR /app

# This image defines APP_UID=1654 but defaults to root; the final stage still switches
# to USER $APP_UID, so the Worker remains non-root.
#
# The SDK needs a writable HOME for the NuGet cache and CLI state, and uid 1654 has no
# home directory in this base — without one, `dotnet build` fails trying to write to a
# read-only $HOME. It is placed inside the Factory's own tree, which the final stage
# already chowns.
ENV DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_ENVIRONMENT=Production \
    AI_FACTORY_HEALTH_DIR=/tmp/ai-factory-health \
    DOTNET_CLI_TELEMETRY_OPTOUT=true \
    DOTNET_NOLOGO=true \
    HOME=/var/lib/ai-factory/home \
    DOTNET_CLI_HOME=/var/lib/ai-factory/home \
    NUGET_PACKAGES=/var/lib/ai-factory/home/.nuget/packages

# Healthcheck represents LIVENESS ("is the process alive?"), not readiness — a
# worker.degraded (transient dependency failure) worker is still alive and must
# not be restarted by the container orchestrator, so this intentionally checks
# worker.live only. Deployment orchestrators that need readiness semantics
# (e.g. to route work / gate rollout) should poll worker.ready separately.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD test -f /tmp/ai-factory-health/worker.live || exit 1

# Stage 2: Build & Restore
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Layer caching: copy solution and project files first
COPY apps/AI.Factory.slnx apps/
COPY apps/src/AI.Factory.Domain/AI.Factory.Domain.csproj apps/src/AI.Factory.Domain/
COPY apps/src/AI.Factory.Application/AI.Factory.Application.csproj apps/src/AI.Factory.Application/
COPY apps/src/AI.Factory.Infrastructure/AI.Factory.Infrastructure.csproj apps/src/AI.Factory.Infrastructure/
COPY apps/src/AI.Factory.Api/AI.Factory.Api.csproj apps/src/AI.Factory.Api/
COPY apps/src/AI.Factory.Worker/AI.Factory.Worker.csproj apps/src/AI.Factory.Worker/
COPY apps/tests/AI.Factory.Application.Tests/AI.Factory.Application.Tests.csproj apps/tests/AI.Factory.Application.Tests/
COPY apps/tests/AI.Factory.Worker.Tests/AI.Factory.Worker.Tests.csproj apps/tests/AI.Factory.Worker.Tests/
COPY apps/tests/AI.Factory.Api.Tests/AI.Factory.Api.Tests.csproj apps/tests/AI.Factory.Api.Tests/

RUN dotnet restore apps/src/AI.Factory.Worker/AI.Factory.Worker.csproj

# Copy remaining source code
COPY apps/src/ apps/src/

# Version metadata (Phase 17.5.1) — property names match apps/Directory.Build.props exactly.
# Local builds keep the defaults below; CI/release builds override them via --build-arg.
ARG BUILD_VERSION=0.0.0-dev
ARG GIT_COMMIT=local
ARG GIT_BRANCH=local
ARG BUILD_NUMBER=0
ARG BUILD_TIMESTAMP_UTC=unknown

# Build in Release configuration
WORKDIR /src/apps/src/AI.Factory.Worker
RUN dotnet build AI.Factory.Worker.csproj -c Release --no-restore -p:SemanticVersion=$BUILD_VERSION -p:GitCommit=$GIT_COMMIT -p:GitBranch=$GIT_BRANCH -p:BuildNumber=$BUILD_NUMBER

# Stage 3: Publish
FROM build AS publish
RUN dotnet publish AI.Factory.Worker.csproj -c Release -o /app/publish --no-build /p:UseAppHost=false

# Stage 4: Final Production Runtime Image
FROM base AS final
WORKDIR /app

# Docker ARGs don't cross stages — redeclare, then expose as runtime ENV so
# DeploymentDiagnosticsService (Phase 17.5.1) can read them from the running container.
ARG BUILD_VERSION=0.0.0-dev
ARG GIT_COMMIT=local
ARG GIT_BRANCH=local
ARG BUILD_NUMBER=0
ARG BUILD_TIMESTAMP_UTC=unknown
# The Dockerfile alone doesn't know the repo URL, so it's passed in separately (defaults to
# "unknown" for local builds; release.yml passes the real https://github.com/<owner>/<repo>).
ARG IMAGE_SOURCE_URL=unknown
ENV BUILD_COMMIT=$GIT_COMMIT \
    BUILD_BRANCH=$GIT_BRANCH \
    BUILD_NUMBER=$BUILD_NUMBER \
    BUILD_TIMESTAMP_UTC=$BUILD_TIMESTAMP_UTC

# Standard OCI labels (phase 17.5.2). Values come from the same ARGs used for the assembly
# version metadata above (SemanticVersion/GitCommit/BuildTimestampUtc via Directory.Build.props),
# and release.yml passes matching --label flags at build time — no independent version source.
LABEL org.opencontainers.image.version=$BUILD_VERSION \
      org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.created=$BUILD_TIMESTAMP_UTC \
      org.opencontainers.image.source=$IMAGE_SOURCE_URL

# Docker CLI only — no daemon, no containerd, no runc. The Worker uses it solely to
# run the Hermes agent container against the socket the deployment mounts in.
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker

# Ensure persistent, temporary, and workspace directory structures exist and are owned by non-root user
RUN mkdir -p /var/lib/ai-factory/data /var/lib/ai-factory/workspace /var/lib/ai-factory/hermes \
             /var/lib/ai-factory/home/.nuget/packages /tmp/ai-factory-health && \
    chown -R $APP_UID:$APP_UID /var/lib/ai-factory /tmp/ai-factory-health /app

# Copy published artifacts from publish stage
COPY --from=publish --chown=$APP_UID:$APP_UID /app/publish .

# Run as dedicated non-root user (UID 1654)
USER $APP_UID

# Exec-form entrypoint ensures SIGTERM signals are received directly by the .NET process
ENTRYPOINT ["dotnet", "AI.Factory.Worker.dll"]
