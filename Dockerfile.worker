# ------------------------------------------------------------
# AI.Factory.Worker — Production Multi-Stage Dockerfile
# ------------------------------------------------------------

# Stage 1: Runtime Base
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS base
WORKDIR /app
ENV DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_ENVIRONMENT=Production \
    AI_FACTORY_HEALTH_DIR=/tmp/ai-factory-health

# Healthcheck testing the presence of worker readiness signal
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD test -f /tmp/ai-factory-health/worker.ready || exit 1

# Stage 2: Build & Restore
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Layer caching: copy solution and project files first
COPY apps/AI.Factory.slnx apps/
COPY apps/src/AI.Factory.Domain/AI.Factory.Domain.csproj apps/src/AI.Factory.Domain/
COPY apps/src/AI.Factory.Application/AI.Factory.Application.csproj apps/src/AI.Factory.Application/
COPY apps/src/AI.Factory.Infrastructure/AI.Factory.Infrastructure.csproj apps/src/AI.Factory.Infrastructure/
COPY apps/src/AI.Factory.Api/AI.Factory.Api.csproj apps/src/AI.Factory.Api/
COPY apps/src/AI.Factory.Worker/AI.Factory.Worker.csproj apps/src/AI.Factory.Worker/
COPY apps/tests/AI.Factory.Application.Tests/AI.Factory.Application.Tests.csproj apps/tests/AI.Factory.Application.Tests/
COPY apps/tests/AI.Factory.Worker.Tests/AI.Factory.Worker.Tests.csproj apps/tests/AI.Factory.Worker.Tests/
COPY apps/tests/AI.Factory.Api.Tests/AI.Factory.Api.Tests.csproj apps/tests/AI.Factory.Api.Tests/

RUN dotnet restore apps/src/AI.Factory.Worker/AI.Factory.Worker.csproj

# Copy remaining source code
COPY apps/src/ apps/src/

# Build in Release configuration
WORKDIR /src/apps/src/AI.Factory.Worker
RUN dotnet build AI.Factory.Worker.csproj -c Release --no-restore

# Stage 3: Publish
FROM build AS publish
RUN dotnet publish AI.Factory.Worker.csproj -c Release -o /app/publish --no-build /p:UseAppHost=false

# Stage 4: Final Production Runtime Image
FROM base AS final
WORKDIR /app

# Ensure persistent, temporary, and workspace directory structures exist and are owned by non-root user
RUN mkdir -p /var/lib/ai-factory/data /var/lib/ai-factory/workspace /var/lib/ai-factory/hermes /tmp/ai-factory-health && \
    chown -R $APP_UID:$APP_UID /var/lib/ai-factory /tmp/ai-factory-health /app

# Copy published artifacts from publish stage
COPY --from=publish --chown=$APP_UID:$APP_UID /app/publish .

# Run as dedicated non-root user (UID 1654)
USER $APP_UID

# Exec-form entrypoint ensures SIGTERM signals are received directly by the .NET process
ENTRYPOINT ["dotnet", "AI.Factory.Worker.dll"]
