app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- AI Factory repository overrides -------------------------------------
# The repository root .gitignore excludes `data/` (runtime Factory state) and
# `*.lock` (build artefacts). Both patterns match at every depth and would
# silently drop this application's data layer and its dependency lock file
# from version control, so they are re-included here.
!lib/data/
!lib/data/**
!pubspec.lock
