<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Phase M: a relative Project.RootPath resolves under this directory when AgentWorkspace:ProjectsBaseDirectory
         is unset; agent-generated project workspaces must never compile into the Factory itself. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);projects/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.Factory.Application\AI.Factory.Application.csproj" />
    <ProjectReference Include="..\AI.Factory.Infrastructure\AI.Factory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
