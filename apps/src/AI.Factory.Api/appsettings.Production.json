{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "AI.Factory": "Information"
    }
  },
  "ConnectionStrings": {
    "FactoryDatabase": "Data Source=/var/lib/ai-factory/data/factory.db;Cache=Shared"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=/var/lib/ai-factory/data/factory.db;Cache=Shared"
  },
  "DatabaseResilience": {
    "EnableRetries": true,
    "MaxRetryAttempts": 3,
    "InitialRetryDelay": "00:00:00.200",
    "MaxRetryDelay": "00:00:02",
    "EnableOptimisticConcurrency": true,
    "CommandTimeout": "00:00:30"
  },
  "SecretManagement": {
    "Enabled": true,
    "Provider": "Environment",
    "FailFastOnMissingSecret": true
  },
  "AiProviders": {
    "Providers": {
      "OpenRouter": {
        "Enabled": true,
        "BaseUrl": "https://openrouter.ai/api/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "OPENROUTER_API_KEY"
      }
    }
  },
  "Security": {
    "RequireAccessKey": false,
    "AccessKeySecretName": "OPERATIONAL_ACCESS_KEY",
    "Https": {
      "RedirectHttpToHttps": false,
      "EnableHstsInProduction": true
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 1
    },
    "RequestLimits": {
      "MaxRequestBodySizeBytes": 10485760
    },
    "Cors": {
      "Enabled": false
    },
    "Swagger": {
      "EnableInProduction": false
    }
  }
}
