{
  "ConnectionStrings": {
    "FactoryDatabase": "Data Source=../../../data/factory.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=../../../data/factory.db"
  },
  "DatabaseResilience": {
    "EnableRetries": true,
    "MaxRetryAttempts": 3,
    "InitialRetryDelay": "00:00:00.200",
    "MaxRetryDelay": "00:00:02",
    "EnableOptimisticConcurrency": true,
    "CommandTimeout": "00:00:30"
  },
  "Backup": {
    "Enabled": false,
    "BackupDirectory": "",
    "RetentionCount": 7,
    "ValidateAfterBackup": true,
    "BackupTimeout": "00:01:00"
  },
  "SecretManagement": {
    "Enabled": true,
    "Provider": "Environment",
    "FailFastOnMissingSecret": true
  },
  "AiProviders": {
    "Providers": {
      "OpenRouter": {
        "Enabled": true,
        "BaseUrl": "https://openrouter.ai/api/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "OPENROUTER_API_KEY"
      }
    }
  },
  "ExecutionLimits": {
    "ModelRequestTimeoutSeconds": 30,
    "AgentExecutionTimeoutMinutes": 5,
    "BuildTimeoutMinutes": 5,
    "TestTimeoutMinutes": 10,
    "MaxRepairAttempts": 3,
    "MaxWorkflowDurationMinutes": 30
  },
  "Hermes": {
    "DockerImage": "nousresearch/hermes-agent:latest",
    "WorkspaceRoot": "../../../sandbox/agent-workspace",
    "TimeoutSeconds": 300,
    "MaxOutputLength": 100000,
    "NetworkMode": "none"
  },
  "CommandPolicy": {
    "AllowedCommands": [ "docker", "dotnet" ],
    "DeniedCommands": [ "rm", "del", "rmdir", "format", "shutdown", "reboot", "curl", "wget", "powershell", "pwsh", "cmd", "bash", "sh", "ssh", "scp" ]
  },
  "ModelRouting": {
    "Models": [
      { "ModelId": "strong-reasoning-model-a", "Provider": "openrouter", "ReasoningStrength": 5, "MaxContextTokens": 200000, "CostTier": 4, "IsCodingOptimized": false, "IsAvailable": true },
      { "ModelId": "strong-reasoning-model-b", "Provider": "openrouter", "ReasoningStrength": 4, "MaxContextTokens": 128000, "CostTier": 3, "IsCodingOptimized": false, "IsAvailable": true },
      { "ModelId": "coding-optimized-model-a", "Provider": "openrouter", "ReasoningStrength": 4, "MaxContextTokens": 128000, "CostTier": 3, "IsCodingOptimized": true, "IsAvailable": true },
      { "ModelId": "coding-optimized-model-b", "Provider": "openrouter", "ReasoningStrength": 3, "MaxContextTokens": 64000, "CostTier": 2, "IsCodingOptimized": true, "IsAvailable": true },
      { "ModelId": "independent-strong-model-a", "Provider": "openrouter", "ReasoningStrength": 5, "MaxContextTokens": 200000, "CostTier": 4, "IsCodingOptimized": false, "IsAvailable": true },
      { "ModelId": "cheap-model-a", "Provider": "openrouter", "ReasoningStrength": 2, "MaxContextTokens": 32000, "CostTier": 1, "IsCodingOptimized": false, "IsAvailable": true }
    ],
    "CategoryProfiles": {
      "requirements-analysis": [ "strong-reasoning-model-a", "strong-reasoning-model-b" ],
      "architecture": [ "strong-reasoning-model-a", "strong-reasoning-model-b" ],
      "planning": [ "strong-reasoning-model-a" ],
      "coding": [ "coding-optimized-model-a", "coding-optimized-model-b" ],
      "debugging": [ "coding-optimized-model-a" ],
      "testing": [ "coding-optimized-model-a" ],
      "code-review": [ "independent-strong-model-a" ],
      "documentation": [ "cheap-model-a" ]
    }
  },
  "TaskPlanner": {
    "MaxAttempts": 3
  },
  "Retry": {
    "MaxAttempts": 3,
    "BaseDelay": "00:00:00.200",
    "MaxDelay": "00:00:05",
    "JitterFactor": 0.2
  },
  "CircuitBreaker": {
    "Hermes": {
      "ConsecutiveFailureThreshold": 5,
      "BreakDuration": "00:00:30",
      "HalfOpenTrialCount": 1
    }
  },
  "Audit": {
    "RetentionDays": 90,
    "FailOnAuditError": false
  },
  "Resilience": {
    "Profiles": {
      "AgentExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 2,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:15",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:05:00",
        "OperationTimeout": "00:15:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": true,
          "FailureThreshold": 5,
          "BreakDuration": "00:00:30",
          "HalfOpenTrialCount": 1
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 2,
          "MaxQueueLength": 5
        }
      },
      "ProviderCall": {
        "Enabled": true,
        "MaxRetryAttempts": 3,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:10",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:01:00",
        "OperationTimeout": "00:05:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": true,
          "FailureThreshold": 5,
          "BreakDuration": "00:00:30",
          "HalfOpenTrialCount": 1
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 10,
          "MaxQueueLength": 20
        }
      },
      "BuildExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 0,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:05",
        "BackoffType": "Constant",
        "UseJitter": false,
        "AttemptTimeout": "00:03:00",
        "OperationTimeout": "00:05:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 2,
          "MaxQueueLength": 5
        }
      },
      "TestExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 0,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:05",
        "BackoffType": "Constant",
        "UseJitter": false,
        "AttemptTimeout": "00:05:00",
        "OperationTimeout": "00:10:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 2,
          "MaxQueueLength": 5
        }
      },
      "RepairExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 1,
        "InitialDelay": "00:00:02",
        "MaxDelay": "00:00:10",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:05:00",
        "OperationTimeout": "00:15:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 1,
          "MaxQueueLength": 2
        }
      },
      "BackgroundOperation": {
        "Enabled": true,
        "MaxRetryAttempts": 3,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:30",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:02:00",
        "OperationTimeout": "00:10:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 5,
          "MaxQueueLength": 10
        }
      }
    }
  },
  "Health": {
    "CheckOpenViking": false
  },
  "Orchestration": {
    "WorkspaceRoot": "../../../sandbox/agent-workspace",
    "MaxAttempts": 3,
    "QueuePollingInterval": "00:00:05",
    "ExecutionTimeout": "00:30:00"
  },
  "OpenViking": {
    "Enabled": false,
    "BaseUrl": "https://openviking.invalid/",
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Shutdown": {
    "GracefulTimeoutSeconds": 30,
    "ForceCancellationAfterSeconds": 25
  },
  "Security": {
    "OperationalEndpoints": {
      "RequireAccessKey": false,
      "AccessKey": "",
      "HeaderName": "X-Operations-Key"
    },
    "RateLimiting": {
      "Enabled": true,
      "General": {
        "PermitLimit": 100,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Operational": {
        "PermitLimit": 50,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Expensive": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    },
    "RequestLimits": {
      "MaxRequestBodySizeBytes": 262144
    },
    "Headers": {
      "EnableContentSecurityPolicy": true,
      "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'",
      "FrameOptions": "DENY",
      "ReferrerPolicy": "no-referrer",
      "PermissionsPolicy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    },
    "Cors": {
      "Enabled": false,
      "AllowedOrigins": []
    },
    "OpenApi": {
      "Enabled": null
    },
    "Https": {
      "RedirectHttpToHttps": false,
      "EnableHstsInProduction": true
    },
    "ForwardedHeaders": {
      "Enabled": false
    }
  },
  "AllowedHosts": "*"
}
