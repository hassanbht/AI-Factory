{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Phase M — a runnable local setup without manual repair (benchmark: nine config fixes before the first
  // correct run). Secrets are NAMES only; values come from the environment (see docs/local-setup.md).
  "AgentWorkspace": {
    // Project workspaces live outside the source tree (they used to land under apps/src/AI.Factory.Api/projects).
    "ProjectsBaseDirectory": "../../../projects",
    "AllowedRoot": "../../../projects"
  },
  "AgentWorker": {
    // Coding agents routinely need more than the 5-minute base budget (benchmark T1-r2 timed out at 285 s).
    "ExecutionTimeout": "00:15:00"
  },
  "Hermes": {
    "Provider": "openrouter",
    "ProviderApiKeyEnvironmentVariable": "OPENROUTER_API_KEY",
    "ProviderApiKeySecretName": "OPENROUTER_API_KEY",
    "NetworkMode": "bridge",
    "TimeoutSeconds": 900
  }
}
