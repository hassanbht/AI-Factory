{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "AI.Factory": "Information"
    }
  },
  "ConnectionStrings": {
    "FactoryDatabase": "Data Source=/var/lib/ai-factory/data/factory.db;Cache=Shared"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=/var/lib/ai-factory/data/factory.db;Cache=Shared"
  },
  "DatabaseResilience": {
    "EnableRetries": true,
    "MaxRetryAttempts": 3,
    "InitialRetryDelay": "00:00:00.200",
    "MaxRetryDelay": "00:00:02",
    "EnableOptimisticConcurrency": true,
    "CommandTimeout": "00:00:30"
  },
  "SecretManagement": {
    "Enabled": true,
    "Provider": "Environment",
    "FailFastOnMissingSecret": true
  },
  "AiProviders": {
    "Providers": {
      "OpenRouter": {
        "Enabled": true,
        "BaseUrl": "https://openrouter.ai/api/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "OPENROUTER_API_KEY"
      }
    }
  },
  "Security": {
    "RequireAccessKey": false,
    "AccessKeySecretName": "OPERATIONAL_ACCESS_KEY"
  },
  // Phase 18.29.1 — production agent execution budget.
  //
  // The shipped 5-minute budget was measured as too tight for real agent work as far
  // back as Phase 18.20 ("auto/coding:free exceeds the shipped 5-minute agent execution
  // budget on the repair objective, reproducibly"), and it was recorded there as needing
  // a deliberate product decision rather than a silent bump. This is that decision: a
  // live containerized Golden Lifecycle had a Documentation WorkItem cancelled at
  // 299,930ms — the 300s limit — with the agent still working normally.
  //
  // 15 minutes per attempt. This is an execution BUDGET, not a gate: no test, acceptance
  // criterion, structured-result check or release gate is relaxed by it. A genuinely hung
  // agent is still bounded, just at a limit real work fits inside.
  "ExecutionLimits": {
    "ModelRequestTimeoutSeconds": 120,
    "AgentExecutionTimeoutMinutes": 15,
    "BuildTimeoutMinutes": 5,
    "TestTimeoutMinutes": 10,
    "MaxRepairAttempts": 3,
    "MaxWorkflowDurationMinutes": 120
  },

  // Every layer that can cut an agent execution short has to agree, or the smallest one
  // silently wins — which is what happened at 300s. AttemptTimeout matches the 15-minute
  // per-attempt budget; OperationTimeout covers 3 attempts (MaxRetryAttempts 2) plus
  // backoff without itself becoming the binding limit.
  "Resilience": {
    "Profiles": {
      "AgentExecution": {
        "AttemptTimeout": "00:15:00",
        "OperationTimeout": "00:50:00"
      }
    }
  },

  // The Worker's own per-AgentRun ceiling, outside the resilience executor. Kept above
  // the inner budget so it bounds a stuck run without pre-empting a healthy one.
  "AgentWorker": {
    "ExecutionTimeout": "00:20:00"
  },
  "Execution": {
    "DefaultProfile": "Hermes",
    "Profiles": {
      "Hermes": {
        "Adapter": "Hermes"
      },
      "OpenHands": {
        "Adapter": "OpenHands"
      },
      "FastCoding": {
        "Adapter": "OpenHands"
      }
    },
    "AgentTypeProfiles": {
      "Implementation": "OpenHands",
      "Repair": "OpenHands",
      "Review": "Hermes"
    },
    "Adapters": {
      "Hermes": {
        "Enabled": true
      },
      "OpenHands": {
        "Enabled": true
      }
    }
  },
  "Hermes": {
    "ExecutablePath": "hermes",
    "DataVolume": "/var/lib/ai-factory/hermes",
    "WorkspaceRoot": "/var/lib/ai-factory/workspace",

    // The docker-run ceiling for the Hermes container itself — the layer that actually
    // fired at 299,930ms. Raised in lockstep with the budget above.
    "TimeoutSeconds": 900,

    // Phase 18.29.1 — explicit production Hermes execution contract. Before this,
    // production inherited NetworkMode "none" and no provider at all from the base
    // appsettings, so a real LLM call was impossible even once the Docker CLI existed.
    //
    // "bridge" is required: Hermes reaches https://openrouter.ai/api/v1 over the
    // network. It is the least permissive mode that still permits that; "host" would
    // additionally expose the host's network namespace and is not used.
    "NetworkMode": "bridge",

    // Which provider Hermes is told to use (`--provider openrouter`). Matches the
    // AiProviders.OpenRouter entry above — one provider identity, not two.
    "Provider": "openrouter",

    // NAMES ONLY. ProviderApiKeySecretName is looked up through the existing
    // EnvironmentSecretProvider at execution time and injected into the Hermes
    // container as ProviderApiKeyEnvironmentVariable. The key VALUE never appears
    // in this file, in any compose file, in the image, or in any log line.
    "ProviderApiKeyEnvironmentVariable": "OPENROUTER_API_KEY",
    "ProviderApiKeySecretName": "OPENROUTER_API_KEY",

    // Make files the agent writes into the shared workspace volume land under the
    // Worker's own UID/GID, so the Worker's subsequent build/test/repair steps can
    // still write them — root-owned agent output breaks the repair loop on its
    // first write.
    //
    // This is the Hermes image's supported mechanism. `docker run --user` is NOT:
    // the image runs an s6-overlay supervision tree that must bootstrap as root and
    // refuses to start under a pinned arbitrary UID ("container started with
    // --user 1654 (an arbitrary, non-hermes UID) — not supported"), verified
    // against nousresearch/hermes-agent:latest.
    //
    // HOME/DOTNET_CLI_HOME point at Hermes's own /opt/data volume, NOT at /workspace.
    // Without this the agent's toolchain treats the shared workspace as its home and
    // unpacks itself there: a live run vendored an entire .NET SDK (templates,
    // sdk-manifests, nupkgs) into the Project workspace. That is not just clutter —
    // FileSystemArtifactRecorder then recorded thousands of artifact rows, and the
    // review prompt built from them blew past the OS argument limit, so the
    // independent review stage failed outright with "Argument list too long".
    "AdditionalEnvironmentVariables": {
      "HERMES_UID": "1654",
      "HERMES_GID": "1654",
      "HOME": "/opt/data",
      "DOTNET_CLI_HOME": "/opt/data",
      "NUGET_PACKAGES": "/opt/data/.nuget/packages"
    }
  },
  "AgentWorkspace": {
    // Every Project workspace resolves inside the workspace volume that both the
    // Worker and the Hermes container share, and is boundary-checked against it.
    // Without this, a relative Project.RootPath would resolve against the process
    // CWD (/app), outside the volume, and could not be mounted into Hermes at all.
    "ProjectsBaseDirectory": "/var/lib/ai-factory/workspace",
    "AllowedRoot": "/var/lib/ai-factory/workspace"
  },
  "Orchestration": {
    "WorkspaceRoot": "/var/lib/ai-factory/workspace"
  },

  // Phase 18.29.1 — production model routing, every id live-validated against
  // https://openrouter.ai/api/v1 before being configured here.
  //
  // qwen/qwen3-coder was replaced for coding/debugging/testing: in a live containerized
  // Golden Lifecycle it emitted a .csproj that MSBuild rejected outright (MSB4025,
  // "'\' is an unexpected token") on a trivial class library, and the bounded repair
  // budget was exhausted without recovering. anthropic/claude-sonnet-5 and openai/gpt-5.1
  // were both asked for the same minimal csproj and both returned clean, valid XML.
  //
  // code-review deliberately routes to a DIFFERENT vendor than implementation, so the
  // review stage is not the implementing model grading its own work.
  //
  // planning/architecture/requirements-analysis stay on the free DeepSeek route, which
  // produced correct, materializable plans in every live run and never failed.
  //
  // No auto-router (openrouter/auto, openrouter/auto-beta), no implicit default: an
  // unmapped role still fails closed in AgentOrchestrator.
  "ModelRouting": {
    "Models": [
      {
        "ModelId": "anthropic/claude-sonnet-5",
        "Provider": "openrouter",
        "ReasoningStrength": 5,
        "MaxContextTokens": 1000000,
        "CostTier": 3,
        "IsCodingOptimized": true,
        "IsAvailable": true,
        "Capabilities": [ "CodeGeneration", "GeneralChat", "Planning", "Reasoning", "CodeReview", "Summarization" ]
      },
      {
        "ModelId": "openai/gpt-5.1",
        "Provider": "openrouter",
        "ReasoningStrength": 5,
        "MaxContextTokens": 400000,
        "CostTier": 3,
        "IsCodingOptimized": true,
        "IsAvailable": true,
        "Capabilities": [ "CodeGeneration", "GeneralChat", "Planning", "Reasoning", "CodeReview", "Summarization" ]
      },
      {
        "ModelId": "deepseek/deepseek-v4-flash-0731:free",
        "Provider": "openrouter",
        "ReasoningStrength": 4,
        "MaxContextTokens": 128000,
        "CostTier": 1,
        "IsCodingOptimized": false,
        "IsAvailable": true,
        "Capabilities": [ "CodeGeneration", "GeneralChat", "Planning", "Reasoning", "CodeReview", "Summarization" ]
      }
    ],
    "CategoryProfiles": {
      "requirements-analysis": [ "deepseek/deepseek-v4-flash-0731:free" ],
      "architecture": [ "deepseek/deepseek-v4-flash-0731:free" ],
      "planning": [ "deepseek/deepseek-v4-flash-0731:free" ],
      "coding": [ "anthropic/claude-sonnet-5" ],
      "debugging": [ "anthropic/claude-sonnet-5" ],
      "testing": [ "anthropic/claude-sonnet-5" ],
      "code-review": [ "openai/gpt-5.1" ],
      "documentation": [ "anthropic/claude-sonnet-5" ]
    },
    "AgentTypeCategories": {
      "Implementation": "coding",
      "Repair": "debugging",
      "Test": "testing",
      "Review": "code-review",
      "Planner": "planning",
      "Documentation": "documentation"
    }
  },

  // Phase 18.29.1 — reject a configured model the configured provider cannot serve,
  // at startup, rather than discovering it at the first agent run. See
  // ModelRoutingPreflight. An invalid model id is fatal in production; a provider
  // OUTAGE is not, and the two stay distinguishable in the logs and diagnostics.
  "ModelRoutingPreflight": {
    "Enabled": true,
    "FailStartupOnUnservableModel": true,
    "TimeoutSeconds": 60
  }
}
