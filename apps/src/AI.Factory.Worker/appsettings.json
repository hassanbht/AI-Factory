    "Models": {}
  },
  "Codex": {
    "ExecutablePath": "codex",
    "TimeoutSeconds": 900,
    "CredentialSecretName": "OPENAI_API_KEY",
    "CredentialEnvironmentVariable": "CODEX_API_KEY",
    "Sandbox": "workspace-write",
    "Models": {}
  },
  "ModelGateway": {
    "DefaultGateway": "OpenRouter",
    "Gateways": {
      "OpenRouter": {
        "Enabled": true,
