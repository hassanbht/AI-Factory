{
  "ConnectionStrings": {
    "FactoryDatabase": "Data Source=../../../data/factory.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=../../../data/factory.db"
  },
  "DatabaseResilience": {
    "EnableRetries": true,
    "MaxRetryAttempts": 3,
    "InitialRetryDelay": "00:00:00.200",
    "MaxRetryDelay": "00:00:02",
    "EnableOptimisticConcurrency": true,
    "CommandTimeout": "00:00:30"
  },
  "SecretManagement": {
    "Enabled": true,
    "Provider": "Environment",
    "FailFastOnMissingSecret": true
  },
  "AiProviders": {
    "Providers": {
      "openrouter": {
        "Enabled": true,
        "BaseUrl": "https://openrouter.ai/api/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "OPENROUTER_API_KEY",
        "ProviderType": "OpenAiCompatible",
        "Priority": 100,
        "TimeoutSeconds": 60
      },
      "omniroute": {
        "Enabled": false,
        "BaseUrl": "http://localhost:20128/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "OMNIROUTE_API_KEY",
        "ProviderType": "OpenAiCompatible",
        "Priority": 80,
        "TimeoutSeconds": 60
      },
      "krouter": {
        "Enabled": false,
        "BaseUrl": "http://localhost:20128/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "KROUTER_API_KEY",
        "ProviderType": "OpenAiCompatible",
        "Priority": 80,
        "TimeoutSeconds": 60
      }
    }
  },
  "AiRouting": {
    "MaxFallbackAttempts": 3,
    "CapabilityPreferredModel": {}
  },
  "ExecutionLimits": {
    "ModelRequestTimeoutSeconds": 30,
    "AgentExecutionTimeoutMinutes": 5,
    "BuildTimeoutMinutes": 5,
    "TestTimeoutMinutes": 10,
    "MaxRepairAttempts": 3,
    "MaxWorkflowDurationMinutes": 30
  },
  "Recovery": {
    "StaleExecutionTimeout": "00:15:00",
    "PeriodicSweepInterval": "00:05:00"
  },
  "Hermes": {
    "DockerImage": "nousresearch/hermes-agent:latest",
    "WorkspaceRoot": "../../../sandbox/agent-workspace",
    "TimeoutSeconds": 300,
    "MaxOutputLength": 100000,
    "NetworkMode": "none"
  },
  "CommandPolicy": {
    "AllowedCommands": [ "docker", "dotnet", "git" ],
    "DeniedCommands": [ "rm", "del", "rmdir", "format", "shutdown", "reboot", "curl", "wget", "powershell", "pwsh", "cmd", "bash", "sh", "ssh", "scp" ]
  },
  "ModelRouting": {
    "Models": [
      { "ModelId": "strong-reasoning-model-a", "Provider": "openrouter", "ReasoningStrength": 5, "MaxContextTokens": 200000, "CostTier": 4, "IsCodingOptimized": false, "IsAvailable": true, "Capabilities": [ "Planning", "Reasoning" ] },
      { "ModelId": "strong-reasoning-model-b", "Provider": "openrouter", "ReasoningStrength": 4, "MaxContextTokens": 128000, "CostTier": 3, "IsCodingOptimized": false, "IsAvailable": true, "Capabilities": [ "Planning", "Reasoning" ] },
      { "ModelId": "coding-optimized-model-a", "Provider": "openrouter", "ReasoningStrength": 4, "MaxContextTokens": 128000, "CostTier": 3, "IsCodingOptimized": true, "IsAvailable": true, "Capabilities": [ "CodeGeneration", "GeneralChat" ] },
      { "ModelId": "coding-optimized-model-b", "Provider": "openrouter", "ReasoningStrength": 3, "MaxContextTokens": 64000, "CostTier": 2, "IsCodingOptimized": true, "IsAvailable": true, "Capabilities": [ "CodeGeneration" ] },
      { "ModelId": "independent-strong-model-a", "Provider": "openrouter", "ReasoningStrength": 5, "MaxContextTokens": 200000, "CostTier": 4, "IsCodingOptimized": false, "IsAvailable": true, "Capabilities": [ "CodeReview" ] },
      { "ModelId": "cheap-model-a", "Provider": "openrouter", "ReasoningStrength": 2, "MaxContextTokens": 32000, "CostTier": 1, "IsCodingOptimized": false, "IsAvailable": true, "Capabilities": [ "Summarization", "GeneralChat" ] }
    ],
    "CategoryProfiles": {
      "requirements-analysis": [ "strong-reasoning-model-a", "strong-reasoning-model-b" ],
      "architecture": [ "strong-reasoning-model-a", "strong-reasoning-model-b" ],
      "planning": [ "strong-reasoning-model-a" ],
      "coding": [ "coding-optimized-model-a", "coding-optimized-model-b" ],
      "debugging": [ "coding-optimized-model-a" ],
      "testing": [ "coding-optimized-model-a" ],
      "code-review": [ "independent-strong-model-a" ],
      "documentation": [ "cheap-model-a" ]
    }
  },
  "TaskPlanner": {
    "MaxAttempts": 3
  },
  "Retry": {
    "MaxAttempts": 3,
    "BaseDelay": "00:00:00.200",
    "MaxDelay": "00:00:05",
    "JitterFactor": 0.2
  },
  "CircuitBreaker": {
    "Hermes": {
      "ConsecutiveFailureThreshold": 5,
      "BreakDuration": "00:00:30",
      "HalfOpenTrialCount": 1
    }
  },
  "Audit": {
    "RetentionDays": 90,
    "FailOnAuditError": false
  },
  "Resilience": {
    "Profiles": {
      "AgentExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 2,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:15",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:05:00",
        "OperationTimeout": "00:15:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": true,
          "FailureThreshold": 5,
          "BreakDuration": "00:00:30",
          "HalfOpenTrialCount": 1
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 2,
          "MaxQueueLength": 5
        }
      },
      "ProviderCall": {
        "Enabled": true,
        "MaxRetryAttempts": 3,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:10",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:01:00",
        "OperationTimeout": "00:05:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": true,
          "FailureThreshold": 5,
          "BreakDuration": "00:00:30",
          "HalfOpenTrialCount": 1
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 10,
          "MaxQueueLength": 20
        }
      },
      "BuildExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 0,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:05",
        "BackoffType": "Constant",
        "UseJitter": false,
        "AttemptTimeout": "00:03:00",
        "OperationTimeout": "00:05:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 2,
          "MaxQueueLength": 5
        }
      },
      "TestExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 0,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:05",
        "BackoffType": "Constant",
        "UseJitter": false,
        "AttemptTimeout": "00:05:00",
        "OperationTimeout": "00:10:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 2,
          "MaxQueueLength": 5
        }
      },
      "RepairExecution": {
        "Enabled": true,
        "MaxRetryAttempts": 1,
        "InitialDelay": "00:00:02",
        "MaxDelay": "00:00:10",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:05:00",
        "OperationTimeout": "00:15:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 1,
          "MaxQueueLength": 2
        }
      },
      "BackgroundOperation": {
        "Enabled": true,
        "MaxRetryAttempts": 3,
        "InitialDelay": "00:00:01",
        "MaxDelay": "00:00:30",
        "BackoffType": "Exponential",
        "UseJitter": true,
        "AttemptTimeout": "00:02:00",
        "OperationTimeout": "00:10:00",
        "RetryTransientFailuresOnly": true,
        "CircuitBreaker": {
          "Enabled": false
        },
        "Bulkhead": {
          "Enabled": true,
          "MaxConcurrentExecutions": 5,
          "MaxQueueLength": 10
        }
      }
    }
  },
  "OpenViking": {
    "Enabled": false,
    "BaseUrl": "https://openviking.invalid/",
    "TimeoutSeconds": 10
  },
  "Orchestration": {
    "WorkspaceRoot": "../../../sandbox/agent-workspace",
    "MaxAttempts": 3,
    "QueuePollingInterval": "00:00:05",
    "ExecutionTimeout": "00:30:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Shutdown": {
    "GracefulTimeoutSeconds": 30,
    "ForceCancellationAfterSeconds": 25
  }
}
