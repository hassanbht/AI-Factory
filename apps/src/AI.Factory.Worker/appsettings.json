  "AiProviders": {
    "Providers": {
      "openrouter": {
        "Enabled": true,
        "BaseUrl": "https://openrouter.ai/api/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "OPENROUTER_API_KEY",
        "ProviderType": "OpenAiCompatible"
      },
      "omniroute": {
        "Enabled": false,
        "BaseUrl": "http://localhost:20128/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "OMNIROUTE_API_KEY",
        "ProviderType": "OpenAiCompatible"
      },
      "krouter": {
        "Enabled": false,
        "BaseUrl": "http://localhost:20128/v1",
        "RequiresApiKey": true,
        "ApiKeySecretName": "KROUTER_API_KEY",
        "ProviderType": "OpenAiCompatible"
      }
    }
  },
  "ExecutionLimits": {
    "ModelRequestTimeoutSeconds": 30,
    "AgentExecutionTimeoutMinutes": 5,
    "BuildTimeoutMinutes": 5,
    "TestTimeoutMinutes": 10,
    "MaxRepairAttempts": 3,
    "MaxWorkflowDurationMinutes": 30
  },
  "Recovery": {
    "StaleExecutionTimeout": "00:15:00",
    "OrphanHeartbeatTimeout": "00:02:00",
    "PeriodicSweepInterval": "00:01:00"
  },
  "Execution": {
    "DefaultProfile": "Hermes",
    "Profiles": {
      "Hermes": {
        "Adapter": "Hermes",
        "Gateway": "OpenRouter"
      },
      "OpenHands": {
        "Adapter": "OpenHands",
        "Gateway": "OpenRouter"
      },
      "FastCoding": {
        "Adapter": "OpenHands",
        "Gateway": "OpenRouter"
      },
      "ClaudeCode": {
        "Adapter": "ClaudeCode"
      },
      "Codex": {
        "Adapter": "Codex"
      }
    },
    "AgentTypeProfiles": {
      "Implementation": "OpenHands",
      "Repair": "OpenHands",
      "Review": "Hermes"
    },
    "Adapters": {
      "Hermes": {
        "Enabled": true
      },
      "OpenHands": {
        "Enabled": true
      },
      "ClaudeCode": {
        "Enabled": true
      },
      "Codex": {
        "Enabled": true
      }
    }
  },
  "ClaudeCode": {
    "ExecutablePath": "claude",
    "TimeoutSeconds": 900,
    "CredentialSecretName": "ANTHROPIC_API_KEY",
