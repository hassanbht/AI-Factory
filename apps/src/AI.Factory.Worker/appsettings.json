{
  "ConnectionStrings": {
    "FactoryDatabase": "Data Source=../../../data/factory.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=../../../data/factory.db"
  },
  "DatabaseResilience": {
    "EnableRetries": true,
    "MaxRetryAttempts": 3,
    "InitialRetryDelay": "00:00:00.200",
    "MaxRetryDelay": "00:00:02",
    "EnableOptimisticConcurrency": true,
    "CommandTimeout": "00:00:30"
  },
  "SecretManagement": {
    "Enabled": true,
    "Provider": "Environment",
    "FailFastOnMissingSecret": true
