  "Hermes": {
    "DockerImage": "nousresearch/hermes-agent:0.20.6",
    "WorkspaceRoot": "../../../sandbox/agent-workspace",
    "TimeoutSeconds": 300,
    "MaxOutputLength": 100000,
    "NetworkMode": "none"
  },
  "CommandPolicy": {
    "AllowedCommands": [ "docker", "dotnet", "git", "claude", "codex" ],
    "DeniedCommands": [ "rm", "del", "rmdir", "format", "shutdown", "reboot", "curl", "wget", "powershell", "pwsh", "cmd", "bash", "sh", "ssh", "scp" ]
  },
  "ModelRouting": {
    "Models": [
      { "ModelId": "deepseek/deepseek-v4-flash-0731", "Provider": "openrouter", "ReasoningStrength": 4, "MaxContextTokens": 128000, "CostTier": 1, "IsCodingOptimized": true, "IsAvailable": true, "Capabilities": [ "CodeGeneration", "GeneralChat", "Planning", "Reasoning", "CodeReview", "Summarization" ] }
    ],
    "CategoryProfiles": {
